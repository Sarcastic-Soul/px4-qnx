+
+/**
+ * @file statfs.h
+ *
+ * Portable statfs(). Linux has <sys/statfs.h>, macOS <sys/mount.h>.
+ * QNX only has POSIX statvfs(), so a minimal statfs() is built on it with the
+ * fields PX4 uses (f_bsize, f_blocks, f_bfree, f_bavail). statvfs counts
+ * blocks in f_frsize units, so f_bsize is set to f_frsize to keep
+ * f_blocks * f_bsize equal to the byte size.
+ */
+
+#pragma once
+
+#if defined(__PX4_DARWIN)
+#include <sys/param.h>
+#include <sys/mount.h>
+
+#elif defined(__PX4_QNX)
+#include <sys/statvfs.h>
+
+struct statfs {
+	unsigned long f_bsize;
+	fsblkcnt_t f_blocks;
+	fsblkcnt_t f_bfree;
+	fsblkcnt_t f_bavail;
+};
+
+#pragma GCC diagnostic push
+#pragma GCC diagnostic ignored "-Wshadow"
+static inline int statfs(const char *path, struct statfs *buf)
+{
+	struct statvfs vfs;
+
+	if (statvfs(path, &vfs) != 0) {
+		return -1;
+	}
+
+	buf->f_bsize = vfs.f_frsize ? vfs.f_frsize : vfs.f_bsize;
+	buf->f_blocks = vfs.f_blocks;
+	buf->f_bfree = vfs.f_bfree;
+	buf->f_bavail = vfs.f_bavail;
+	return 0;
+}
+#pragma GCC diagnostic pop
+
+#else
+#include <sys/statfs.h>
+#endif
diff --git a/platforms/common/include/px4_platform_common/tasks.h b/platforms/common/include/px4_platform_common/tasks.h
index 6609b4c..cc87b04 100644
--- a/platforms/common/include/px4_platform_common/tasks.h
+++ b/platforms/common/include/px4_platform_common/tasks.h
@@ -73,6 +73,18 @@ typedef int px4_task_t;
 #define SCHED_PRIORITY_MIN sched_get_priority_min(SCHED_FIFO)
 #define SCHED_PRIORITY_DEFAULT (((sched_get_priority_max(SCHED_FIFO) - sched_get_priority_min(SCHED_FIFO)) / 2) + sched_get_priority_min(SCHED_FIFO))
 
+#elif defined(__PX4_QNX)
+
+/*
+ * QNX 8.0 reserves priority 255 for IPIs and 254 for the clock IST, so cap the
+ * top of the PX4 range at 253. The rest of the PX4 priorities are offsets
+ * below SCHED_PRIORITY_MAX and stay in 1..253.
+ */
+#define PX4_QNX_PRIORITY_CAP 253
+#define SCHED_PRIORITY_MAX ((sched_get_priority_max(SCHED_FIFO) > PX4_QNX_PRIORITY_CAP) ? PX4_QNX_PRIORITY_CAP : sched_get_priority_max(SCHED_FIFO))
+#define SCHED_PRIORITY_MIN sched_get_priority_min(SCHED_FIFO)
+#define SCHED_PRIORITY_DEFAULT (((SCHED_PRIORITY_MAX - SCHED_PRIORITY_MIN) / 2) + SCHED_PRIORITY_MIN)
+
 #elif defined(__PX4_QURT)
 
 #define SCHED_PRIORITY_MAX 255
