diff --git a/platforms/common/px4_log.cpp b/platforms/common/px4_log.cpp
index 73a3671..649df48 100644
--- a/platforms/common/px4_log.cpp
+++ b/platforms/common/px4_log.cpp
@@ -170,7 +170,7 @@ __EXPORT void px4_log_modulename(int level, const char *module_name, const char
 		g_log_history.write(buf);
 #endif // BOARD_ENABLE_LOG_HISTORY
 
-#if defined(CONFIG_ARCH_BOARD_PX4_SITL)
+#if defined(CONFIG_ARCH_BOARD_PX4_SITL) || defined(CONFIG_ARCH_BOARD_QNX_SITL)
 		// Without flushing it's tricky to see stdout output when PX4 is started by
 		// a script like for the MAVSDK tests.
 		fflush(out);
diff --git a/platforms/common/px4_work_queue/WorkQueueManager.cpp b/platforms/common/px4_work_queue/WorkQueueManager.cpp
index 8d22e32..4315bfd 100644
--- a/platforms/common/px4_work_queue/WorkQueueManager.cpp
+++ b/platforms/common/px4_work_queue/WorkQueueManager.cpp
@@ -304,6 +304,17 @@ WorkQueueManagerRun(int, char **)
 				PX4_ERR("getting sched param for %s failed (%i)", wq->name, ret_getschedparam);
 			}
 
+#if defined(__PX4_QNX)
+			// QNX threads inherit the creator's scheduling by default, which
+			// would ignore the policy and priority set below.
+			int ret_setinheritsched = pthread_attr_setinheritsched(&attr, PTHREAD_EXPLICIT_SCHED);
+
+			if (ret_setinheritsched != 0) {
+				PX4_ERR("setting explicit sched for %s failed (%i)", wq->name, ret_setinheritsched);
+			}
+
+#endif
+
 			// schedule policy FIFO
 			int ret_setschedpolicy = pthread_attr_setschedpolicy(&attr, SCHED_FIFO);
 
