From 4e4830fed01093e35be4be8293dec64c4023b89e Mon Sep 17 00:00:00 2001
From: Sarcastic-Soul <anishisbusy@gmail.com>
Date: Wed, 11 Nov 2026 03:49:21 +0530
Subject: [PATCH 3/4] qnx: explicit thread scheduling, SIH board config,
 MAVLink partner IP

---
 ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink      | 11 +++++++++--
 boards/qnx/sitl/default.px4board                     | 11 +++++++++--
 platforms/common/px4_log.cpp                         |  2 +-
 platforms/common/px4_work_queue/WorkQueueManager.cpp | 11 +++++++++++
 platforms/posix/cmake/Toolchain-qnx-x86_64.cmake     |  3 ++-
 src/modules/commander/Commander.cpp                  |  2 +-
 src/modules/commander/worker_thread.cpp              |  5 +++++
 src/modules/logger/log_writer_file.cpp               |  5 +++++
 src/modules/mavlink/mavlink_receiver.cpp             |  5 +++++
 src/modules/simulation/pwm_out_sim/CMakeLists.txt    |  2 +-
 src/modules/simulation/pwm_out_sim/PWMSim.hpp        |  2 +-
 11 files changed, 50 insertions(+), 9 deletions(-)

diff --git a/ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink b/ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink
index 17ef445..159e1c6 100644
--- a/ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink
+++ b/ROMFS/px4fmu_common/init.d-posix/px4-rc.mavlink
@@ -10,8 +10,15 @@ udp_onboard_gimbal_port_local=$((13030+px4_instance))
 udp_onboard_gimbal_port_remote=$((13280+px4_instance))
 udp_gcs_port_local=$((18570+px4_instance))
 
+# Optional partner IP for the GCS and offboard links (e.g. 10.0.2.2, the host
+# seen from a QEMU guest with user-mode networking). Default: localhost.
+mavlink_partner=""
+if [ -n "$PX4_MAVLINK_PARTNER_IP" ]; then
+	mavlink_partner="-t $PX4_MAVLINK_PARTNER_IP"
+fi
+
 # GCS link
-mavlink start -x -u $udp_gcs_port_local -r 4000000 -f
+mavlink start -x -u $udp_gcs_port_local -r 4000000 -f $mavlink_partner
 mavlink stream -r 50 -s POSITION_TARGET_LOCAL_NED -u $udp_gcs_port_local
 mavlink stream -r 50 -s LOCAL_POSITION_NED -u $udp_gcs_port_local
 mavlink stream -r 50 -s GLOBAL_POSITION_INT -u $udp_gcs_port_local
@@ -23,7 +30,7 @@ mavlink stream -r 20 -s RC_CHANNELS -u $udp_gcs_port_local
 mavlink stream -r 10 -s OPTICAL_FLOW_RAD -u $udp_gcs_port_local
 
 # API/Offboard link
-mavlink start -x -u $udp_offboard_port_local -r 4000000 -f -m onboard -o $udp_offboard_port_remote
+mavlink start -x -u $udp_offboard_port_local -r 4000000 -f -m onboard -o $udp_offboard_port_remote $mavlink_partner
 
 # Onboard link to camera
 mavlink start -x -u $udp_onboard_payload_port_local -r 4000 -f -m onboard -o $udp_onboard_payload_port_remote
