 void Commander::checkAndInformReadyForTakeoff()
 {
-#ifdef CONFIG_ARCH_BOARD_PX4_SITL
+#if defined(CONFIG_ARCH_BOARD_PX4_SITL) || defined(CONFIG_ARCH_BOARD_QNX_SITL)
 	static bool ready_for_takeoff_printed = false;
 
 	if (_vehicle_status.vehicle_type == vehicle_status_s::VEHICLE_TYPE_ROTARY_WING ||
diff --git a/src/modules/commander/worker_thread.cpp b/src/modules/commander/worker_thread.cpp
index 9859da4..7ec48fe 100644
--- a/src/modules/commander/worker_thread.cpp
+++ b/src/modules/commander/worker_thread.cpp
@@ -80,6 +80,11 @@ void WorkerThread::startTask(Request request)
 
 	/* low priority */
 	param.sched_priority = SCHED_PRIORITY_DEFAULT - 50;
+#if defined(__PX4_QNX)
+	// QNX threads inherit the creator's scheduling unless told otherwise
+	(void)pthread_attr_setinheritsched(&low_prio_attr, PTHREAD_EXPLICIT_SCHED);
+	(void)pthread_attr_setschedpolicy(&low_prio_attr, SCHED_FIFO);
+#endif
 	pthread_attr_setschedparam(&low_prio_attr, &param);
 
 	int ret = pthread_create(&_thread_handle, &low_prio_attr, &threadEntryTrampoline, this);
diff --git a/src/modules/logger/log_writer_file.cpp b/src/modules/logger/log_writer_file.cpp
index 851bcec..b39fe3a 100644
--- a/src/modules/logger/log_writer_file.cpp
+++ b/src/modules/logger/log_writer_file.cpp
@@ -289,6 +289,11 @@ int LogWriterFile::thread_start()
 	sched_param param;
 	/* low priority, as this is expensive disk I/O */
 	param.sched_priority = SCHED_PRIORITY_DEFAULT - 40;
+#if defined(__PX4_QNX)
+	// QNX threads inherit the creator's scheduling unless told otherwise
+	(void)pthread_attr_setinheritsched(&thr_attr, PTHREAD_EXPLICIT_SCHED);
+	(void)pthread_attr_setschedpolicy(&thr_attr, SCHED_FIFO);
+#endif
 	(void)pthread_attr_setschedparam(&thr_attr, &param);
 
 	pthread_attr_setstacksize(&thr_attr, PX4_STACK_ADJUSTED(1170));
